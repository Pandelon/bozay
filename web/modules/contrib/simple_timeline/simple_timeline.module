<?php

/**
 * @file
 * Contains simple_timeline.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\simple_timeline\Hook\SimpleTimelineHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function simple_timeline_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(SimpleTimelineHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
#[LegacyHook]
function simple_timeline_theme_suggestions_views_view_simple_timeline_alter(array &$suggestions, array $variables): void {
  \Drupal::service(SimpleTimelineHooks::class)->themeSuggestionsViewsViewSimpleTimelineAlter($suggestions, $variables);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_simple_timeline.
 */
#[LegacyHook]
function simple_timeline_preprocess_views_view_simple_timeline(array &$variables): void {
  \Drupal::service(SimpleTimelineHooks::class)->preprocessViewsViewSimpleTimeline($variables);
}
